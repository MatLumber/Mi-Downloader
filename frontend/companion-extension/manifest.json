{
  "manifest_version": 3,
  "name": "GravityDown Companion",
  "version": "1.0.0",
  "description": "Sincroniza las cookies de YouTube con la app GravityDown para sortear el cifrado app-bound de Chrome 127+ y descargar contenido con sesión iniciada.",
  "permissions": [
    "cookies",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.googlevideo.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GravityDown Companion"
  }
}
